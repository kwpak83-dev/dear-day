{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "dev": false
    }
  },
  "crons": [
    { "path": "/api/gallery/cleanup", "schedule": "0 19 * * *" },
    { "path": "/api/retention/schedule", "schedule": "10 15 * * *" },
